{
  "name": "google-drive-clone",
  "version": "1.0.0",
  "description": "google drive clone used to learn aws vpc networking, uses aws s3 and cognito, and aws dynamodb",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:server": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run tests:watch",
    "tests": "npm run build && jest --runInBand",
    "tests:watch": "tsx watch --clear-screen=false --include './src/**' --include './tests/**' --include './jest.config.cjs' --include './tsconfig.json' --ignore './dist/**' scripts/watch-tests.cjs"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1140.0",
    "@aws-sdk/client-s3": "^3.1140.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "aws-jwt-verify": "^5.2.1",
    "cors": "^2.8.6",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "jest": "^30.5.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
